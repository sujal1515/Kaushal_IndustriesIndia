# Copy to .env.local for development. In production set these in Vercel → Project → Settings → Environment Variables.
# Without Supabase the public site runs from the bundled catalogue seed and the admin shows a setup notice.

# Canonical site URL (used for canonicals, sitemap, emails)
NEXT_PUBLIC_SITE_URL=https://www.kia-india.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never prefix with NEXT_PUBLIC_. Required to store enquiries and invite admin users.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email via Resend (https://resend.com) — send from a verified subdomain, e.g. notify.kia-india.com
RESEND_API_KEY=
EMAIL_FROM="Kaushal Industries <enquiries@notify.kia-india.com>"
# Fallback recipients if Admin → Settings has none (comma separated)
ENQUIRY_NOTIFY_EMAILS=kia@kia-india.com

# Cloudflare Turnstile (optional but recommended)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Tag Manager container (client-owned). Enables the consent banner.
NEXT_PUBLIC_GTM_ID=

# Random string used to hash visitor IPs for rate limiting
IP_HASH_SALT=change-me-to-a-long-random-string
