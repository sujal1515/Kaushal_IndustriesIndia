/**
 * Generates supabase/seed.sql from src/lib/data/seed.ts — the same data the site
 * renders when Supabase is not configured. Idempotent (ON CONFLICT DO NOTHING).
 *
 *   npm run db:seed-sql
 */
import { writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import {
  seedApplications,
  seedAttributes,
  seedCategories,
  seedFaqs,
  seedProducts,
  seedResources,
} from "../src/lib/data/seed.ts";
import { site } from "../src/lib/site.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number") return String(v);
  if (typeof v === "boolean") return v ? "true" : "false";
  return `'${String(v).replace(/'/g, "''")}'`;
};
const jsonb = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`;
const textArr = (arr: string[]) => (arr.length ? `array[${arr.map(q).join(", ")}]::text[]` : `'{}'::text[]`);

const out: string[] = [
  "-- GENERATED by scripts/generate-seed-sql.ts from src/lib/data/seed.ts — do not edit by hand.",
  "-- Catalogue migrated from www.kia-india.com (crawled 4 Oct 2026).",
  "begin;",
  "",
];

// Categories
out.push("-- Categories");
for (const c of seedCategories) {
  out.push(
    `insert into public.categories (slug, name, description, image_path, sort_order, status, seo_title, seo_description) values (${[
      c.slug, c.name, c.description, c.image_path, c.sort_order,
    ].map(q).join(", ")}, ${q(c.status)}::public.publish_status, ${q(c.seo_title ?? null)}, ${q(c.seo_description ?? null)}) on conflict (slug) do nothing;`,
  );
}

// Attributes
out.push("", "-- Spec attribute dictionary");
for (const [cat, attrs] of Object.entries(seedAttributes)) {
  attrs.forEach((a, i) => {
    out.push(
      `insert into public.spec_attributes (category_id, key, label, unit, data_type, group_label, is_key_spec, is_filterable, sort_order) select id, ${[
        a.key, a.label, a.unit,
      ].map(q).join(", ")}, ${q(a.data_type)}::public.attr_data_type, ${q(a.group_label)}, ${q(a.is_key_spec)}, ${q(a.is_filterable)}, ${i + 1} from public.categories where slug = ${q(cat)} on conflict (category_id, key) do nothing;`,
    );
  });
}

// Applications
out.push("", "-- Applications");
for (const a of seedApplications) {
  out.push(
    `insert into public.applications (slug, name, summary, body_md, image_path, sort_order, status) values (${[
      a.slug, a.name, a.summary, a.body_md, a.image_path, a.sort_order,
    ].map(q).join(", ")}, 'published') on conflict (slug) do nothing;`,
  );
}

// Products, models, values, images, links
out.push("", "-- Products");
for (const p of seedProducts) {
  out.push(
    `insert into public.products (category_id, slug, name, subtitle, summary, description_md, status, is_featured, sort_order, facets, highlights, descriptive_specs, standard_equipment, optional_extras, notes, legacy_path, published_at)
select id, ${[p.slug, p.name, p.subtitle, p.summary, p.description_md].map(q).join(", ")}, ${q(p.status)}::public.publish_status, ${q(p.is_featured)}, ${p.sort_order}, ${jsonb(p.facets)}, ${jsonb(p.highlights)}, ${jsonb(p.descriptive_specs)}, ${textArr(p.standard_equipment)}, ${textArr(p.optional_extras)}, ${textArr(p.notes)}, ${q(p.legacy_path)}, ${p.status === "published" ? "now()" : "null"}
from public.categories where slug = ${q(p.category)} on conflict (slug) do nothing;`,
  );
}

out.push("", "-- Models");
for (const p of seedProducts) {
  p.models.forEach((m, i) => {
    out.push(
      `insert into public.product_models (product_id, model_code, group_label, sort_order, status) select id, ${q(m.code)}, ${q(m.group)}, ${i + 1}, 'published' from public.products where slug = ${q(p.slug)} on conflict (product_id, model_code) do nothing;`,
    );
  });
}

out.push("", "-- Model spec values");
const valueRows: string[] = [];
for (const p of seedProducts) {
  for (const m of p.models) {
    for (const [key, v] of Object.entries(m.values)) {
      const isNum = typeof v === "number";
      valueRows.push(`(${q(p.slug)}, ${q(m.code)}, ${q(key)}, ${isNum ? "null" : q(v)}, ${isNum ? v : "null"})`);
    }
  }
}
if (valueRows.length) {
  out.push(
    `insert into public.model_spec_values (model_id, attribute_id, value_text, value_num)
select m.id, a.id, v.t, v.n::numeric
from (values
  ${valueRows.join(",\n  ")}
) as v(product_slug, model_code, attr_key, t, n)
join public.products p on p.slug = v.product_slug
join public.product_models m on m.product_id = p.id and m.model_code = v.model_code
join public.spec_attributes a on a.category_id = p.category_id and a.key = v.attr_key
on conflict (model_id, attribute_id) do nothing;`,
  );
}

out.push("", "-- Images, applications, related products");
for (const p of seedProducts) {
  p.images.forEach((img, i) => {
    out.push(
      `insert into public.product_images (product_id, storage_path, alt_text, sort_order, is_primary) select id, ${q(img.path)}, ${q(img.alt)}, ${i + 1}, ${i === 0} from public.products where slug = ${q(p.slug)} and not exists (select 1 from public.product_images pi join public.products pp on pp.id = pi.product_id where pp.slug = ${q(p.slug)} and pi.storage_path = ${q(img.path)});`,
    );
  });
  for (const a of p.applications) {
    out.push(
      `insert into public.product_applications (product_id, application_id) select p.id, a.id from public.products p, public.applications a where p.slug = ${q(p.slug)} and a.slug = ${q(a)} on conflict do nothing;`,
    );
  }
  p.related.forEach((r, i) => {
    out.push(
      `insert into public.related_products (product_id, related_product_id, sort_order) select p.id, r.id, ${i + 1} from public.products p, public.products r where p.slug = ${q(p.slug)} and r.slug = ${q(r)} on conflict do nothing;`,
    );
  });
}

out.push("", "-- Resources (certificates & awards)");
for (const r of seedResources) {
  out.push(
    `insert into public.resources (title, type, description, storage_path, mime_type, file_size, issuer, valid_from, valid_to, sort_order, is_published) select ${[
      r.title,
    ].map(q).join(", ")}, ${q(r.type)}::public.resource_type, ${[r.description, r.storage_path, r.mime_type, r.file_size, r.issuer].map(q).join(", ")}, ${q(r.valid_from)}::date, ${q(r.valid_to)}::date, ${r.sort_order}, true where not exists (select 1 from public.resources where storage_path = ${q(r.storage_path)});`,
  );
}

out.push("", "-- FAQs");
for (const f of seedFaqs) {
  out.push(
    `insert into public.faqs (question, answer_md, category_id, sort_order, is_published) select ${q(f.question)}, ${q(f.answer_md)}, ${
      f.category ? `(select id from public.categories where slug = ${q(f.category)})` : "null"
    }, ${f.sort_order}, true where not exists (select 1 from public.faqs where question = ${q(f.question)});`,
  );
}

out.push("", "-- Site settings (public contact values; notification_emails is private)");
const settings: Record<string, unknown> = {
  phones: site.contact.phones,
  whatsapp: site.contact.whatsapp,
  email: site.contact.email,
  address_lines: site.contact.addressLines,
  notification_emails: [site.contact.email],
};
for (const [k, v] of Object.entries(settings)) {
  out.push(`insert into public.site_settings (key, value) values (${q(k)}, ${jsonb(v)}) on conflict (key) do nothing;`);
}

out.push("", "commit;", "");

const target = join(dirname(fileURLToPath(import.meta.url)), "..", "supabase", "seed.sql");
writeFileSync(target, out.join("\n"));
console.log(`Wrote ${target} — ${seedProducts.length} products, ${valueRows.length} spec values.`);
