/**
 * Generates supabase/seed-cms.sql: every CMS page's default content, published as-is.
 * Idempotent — pages already in the database are left untouched.
 *
 *   npm run db:seed-cms
 */
import { writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { cmsPages } from "../src/lib/cms/pages.ts";

const q = (v: string) => `'${v.replace(/'/g, "''")}'`;
const out = [
  "-- GENERATED by scripts/generate-cms-seed.mts from src/lib/cms/pages.ts — do not edit by hand.",
  "-- Publishes the default content of every CMS page. Existing pages are not overwritten.",
  "begin;",
  "",
];
for (const [key, def] of Object.entries(cmsPages)) {
  out.push(`insert into public.cms_pages (key, content) values (${q(key)}, ${q(JSON.stringify(def.defaults))}::jsonb) on conflict (key) do nothing;`);
}
out.push("", "commit;", "");
const file = join(dirname(fileURLToPath(import.meta.url)), "..", "supabase", "seed-cms.sql");
writeFileSync(file, out.join("\n"));
console.log(`Wrote ${Object.keys(cmsPages).length} pages to supabase/seed-cms.sql`);
